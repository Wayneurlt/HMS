# Neon PostgreSQL connection string (required).
# Example: postgresql://user:password@ep-xxxx.region.aws.neon.tech/hostel?sslmode=require
DATABASE_URL=

# Optional: max database connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# Secret used to sign session cookies (required in production).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: protects the reminder cron endpoint (/api/cron/reminders).
# Send as header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Optional: messaging provider for rent reminders. Leave empty to only record
# reminders in the database (no external delivery). Supported now: "log".
# Add new providers in src/lib/messaging/providers.
MESSAGING_PROVIDER=
